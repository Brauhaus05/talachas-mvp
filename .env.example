# Supabase — public values, safe to expose to the browser.
# Local dev: run `pnpm exec supabase start` and copy the printed
# "API URL" and "anon key" here (into .env.local).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. The service role bypasses RLS — never expose it to the client
# or commit a real value. Printed as "service_role key" by `supabase start`.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test mode) — from the Stripe Dashboard (Developers → API keys).
# Connect must be enabled on the account. Server-only; never expose the secret.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` output, or Dashboard → Webhooks → signing secret.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL used to build Stripe return/success URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform commission as a fraction (0.15 = 15%).
PLATFORM_FEE_PCT=0.15
# Country for new Connect (Express) accounts. Production: MX (leave unset).
# Stripe blocks destination charges + application fees across regions, so to
# exercise payments locally against a non-MX platform test account, set this to
# the platform account's country (e.g. CA, US).
# STRIPE_CONNECT_COUNTRY=MX
# Currency for charges + display (ISO 4217). Production: MXN (leave unset).
# Public because it's shown in the UI. Set to the platform account's currency
# to match STRIPE_CONNECT_COUNTRY when testing (charging MXN to a CA-region
# connected account conflicts). e.g. CAD.
# NEXT_PUBLIC_CURRENCY=MXN

# Email notifications (Resend) — Phase 5B
# Create a key at https://resend.com/api-keys. Unset → emails silently no-op.
RESEND_API_KEY=
# Optional; defaults to "Talachas <onboarding@resend.dev>" (works on a fresh account).
EMAIL_FROM=
# Non-prod only: redirect ALL mail to one inbox (real recipient shown in subject).
# Set to your Resend account owner's email to verify locally against seed data.
EMAIL_DEV_REDIRECT=
